# Copy this file to .env and fill in your project values.
# NEVER commit the real .env — it is gitignored.
#
# Where to find these values:
#   Supabase Dashboard → your project → Connect (top bar)
#   or Project Settings → API.
#
# Use the PUBLISHABLE (anon) key only. The service-role / secret key must
# never be placed in a mobile app — it bypasses Row Level Security.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-ANON-KEY
